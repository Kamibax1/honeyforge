# Скопируйте в .env и поменяйте значения перед запуском (секреты не в коде).
HF_JWT_SECRET=change-me-in-env
HF_AGGREGATOR_KEY=change-me-aggregator-key
HF_DB_PASSWORD=hf_center
HF_ADMIN_LOGIN=operator
HF_ADMIN_PASSWORD=honeyforge

# Ключ доступа к WebSocket-ленте realtime-слоя (dashboard).
# Если не задан — используется значение HF_AGGREGATOR_KEY.
RT_FEED_KEY=change-me-feed-key
